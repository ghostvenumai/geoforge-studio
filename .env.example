GEOFORGE_ENV=development
GEOFORGE_HOST=127.0.0.1
GEOFORGE_PORT=8000
GEOFORGE_DATABASE_URL=sqlite:///./data/geoforge.db
GEOFORGE_MAX_UPLOAD_MB=100
GEOFORGE_RUN_WORKERS=2
GEOFORGE_RUN_TIMEOUT_SECONDS=900
GEOFORGE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_URL=http://127.0.0.1:8000/api

# Nur für die optionale Produktion des deutschsprachigen Demo-Videos nötig.
# Die GeoForge-Anwendung selbst arbeitet vollständig ohne API-Schlüssel.
OPENAI_API_KEY=
VIDEO_TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
VIDEO_LANGUAGE=de
